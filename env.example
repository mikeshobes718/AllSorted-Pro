# Vercel / local: copy to .env for local serverless testing
#
# Supabase (caller portal shared pipeline — server only, never expose service role to the browser)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Apply table: from repo root, `supabase link --project-ref YOUR_REF` then `supabase db push`
# (or paste supabase/migrations/*.sql into Dashboard → SQL Editor)
# Lead queue rows live in `portal_queue_leads` (see 20260408120000_portal_queue_leads.sql); required for accurate queue status.
#
# Registration emails (required for admin to receive "new signup" notices):
RESEND_API_KEY=re_xxxxxxxx
# Verified sender in Resend (use your domain after DNS setup):
RESEND_FROM_EMAIL=AllSorted Pro <hello@allsortedpro.com>
# Comma-separated admin inboxes that always receive signup notifications
# (recommended even if the client sends admin emails from the browser):
ADMIN_NOTIFY_EMAILS=hello@allsortedpro.com

# Optional: link in notification email (defaults to https://allsortedpro.com)
# PORTAL_PUBLIC_URL=https://allsortedpro.com
